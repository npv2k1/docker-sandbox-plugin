# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# Used by the opt-in live tests: set -a; . ./.env; set +a; mvn -B -ntp test -Dtest=LiveDockerCloudTest

# Docker account with a personal access token that has "Allow Cloud Sandboxes access"
DOCKER_ID=your-docker-id
DOCKER_PAT=<docker-personal-access-token>

# LLM endpoint used by the OpenCode example test
# LLM_PROVIDER: anthropic | openai | openrouter | google | openai-compatible | anthropic-compatible
LLM_PROVIDER=anthropic-compatible
LLM_BASE_URL=https://your-gateway.example.com/v1
LLM_MODEL=claude-sonnet-4-5
LLM_API_KEY=<llm-api-key>
