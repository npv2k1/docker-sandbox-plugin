<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:section title="Docker Cloud Sandboxes">
    <f:entry title="Accounts" help="/plugin/docker-sandbox/help/accounts.html">
      <f:repeatableProperty field="accounts" add="Add Docker account" minimum="0" />
    </f:entry>
    <f:entry title="Load-balancing strategy" field="strategy">
      <f:select />
    </f:entry>
    <f:entry title="Default kit" field="defaultKit">
      <f:textbox />
    </f:entry>
    <f:entry title="Default size" field="defaultSize">
      <f:select />
    </f:entry>
    <f:entry title="Default sandbox TTL (minutes)" field="defaultTtlMinutes">
      <f:number clazz="positive-number" min="1" default="60" />
    </f:entry>
    <f:advanced>
      <f:entry title="Wait for capacity (minutes)" field="leaseTimeoutMinutes">
        <f:number clazz="positive-number" min="1" default="30" />
      </f:entry>
      <f:entry title="Account cooldown after quota/auth failure (minutes)" field="cooldownMinutes">
        <f:number clazz="non-negative-number" min="0" default="5" />
      </f:entry>
      <f:entry title="Maximum failover attempts" field="maxFailoverAttempts">
        <f:number clazz="positive-number" min="1" default="3" />
      </f:entry>
      <f:entry title="Delete orphaned sandboxes of this Jenkins" field="orphanCleanupEnabled">
        <f:checkbox default="true" />
      </f:entry>
    </f:advanced>
  </f:section>
</j:jelly>
