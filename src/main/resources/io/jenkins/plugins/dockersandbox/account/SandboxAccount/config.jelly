<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:entry title="Account ID" field="id">
    <f:textbox />
  </f:entry>
  <f:entry title="Display name" field="displayName">
    <f:textbox />
  </f:entry>
  <f:entry title="Docker ID + access token" field="credentialsId">
    <c:select />
  </f:entry>
  <f:entry title="Max concurrent sandboxes" field="maxConcurrent">
    <f:number clazz="positive-number" min="1" default="10" />
  </f:entry>
  <f:entry title="Weight" field="weight">
    <f:number clazz="positive-number" min="1" default="1" />
  </f:entry>
  <f:entry title="Labels" field="labels">
    <f:textbox />
  </f:entry>
  <f:entry title="Enabled" field="enabled">
    <f:checkbox default="true" />
  </f:entry>
  <f:advanced>
    <f:entry title="Sandboxes API URL" field="apiUrl">
      <f:textbox default="https://connect.docker.com/sandboxes" />
    </f:entry>
    <f:entry title="Docker auth URL" field="authUrl">
      <f:textbox default="https://hub.docker.com" />
    </f:entry>
  </f:advanced>
  <f:validateButton title="Test connection" progress="Testing..." method="testConnection" with="credentialsId,authUrl,apiUrl" />
  <f:entry>
    <div align="right">
      <f:repeatableDeleteButton />
    </div>
  </f:entry>
</j:jelly>
