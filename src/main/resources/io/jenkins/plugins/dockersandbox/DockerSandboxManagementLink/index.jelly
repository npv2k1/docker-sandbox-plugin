<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:f="/lib/form">
  <l:layout title="Docker Cloud Sandboxes" permission="${app.ADMINISTER}">
    <l:main-panel>
      <h1>Docker Cloud Sandboxes</h1>
      <p>Load-balancing strategy: <b id="strategy">${it.strategyName}</b>.
        Accounts are configured under <a href="${rootURL}/manage/configure">Manage Jenkins &gt; System</a>.</p>
      <p>Default kit: <b id="default-kit">${empty(it.defaultKit) ? '(none)' : it.defaultKit}</b>.
        Default image: <b id="default-image">${empty(it.defaultImage) ? '(none)' : it.defaultImage}</b>
        (a build's image or kit overrides these; an image takes precedence over a kit).</p>
      <j:choose>
        <j:when test="${empty(it.rows)}">
          <p id="no-accounts">No Docker accounts are configured yet.</p>
        </j:when>
        <j:otherwise>
          <table class="jenkins-table sortable" id="accounts">
            <thead>
              <tr>
                <th>Account</th>
                <th>Enabled</th>
                <th>Active / max</th>
                <th>Labels</th>
                <th>Cooldown</th>
                <th>Last error</th>
                <th>Runs</th>
                <th>Failures</th>
                <th>Connection</th>
              </tr>
            </thead>
            <tbody>
              <j:forEach var="row" items="${it.rows}">
                <tr class="account-row" data-account="${row.id}">
                  <td>${row.displayName} <code>(${row.id})</code></td>
                  <td>${row.enabled ? 'yes' : 'no'}</td>
                  <td class="usage">${row.active} / ${row.max}</td>
                  <td>${row.labels}</td>
                  <td>
                    <j:choose>
                      <j:when test="${row.cooldownSeconds gt 0}">${row.cooldownSeconds}s</j:when>
                      <j:otherwise>-</j:otherwise>
                    </j:choose>
                  </td>
                  <td>${row.lastError}</td>
                  <td>${row.totalRuns}</td>
                  <td>${row.totalFailures}</td>
                  <td>
                    <div class="last-test">${row.lastTest}</div>
                    <f:form method="post" action="testConnection?accountId=${row.id}" name="test-${row.id}">
                      <f:submit value="Test connection" />
                    </f:form>
                  </td>
                </tr>
              </j:forEach>
            </tbody>
          </table>
        </j:otherwise>
      </j:choose>
      <j:set var="persistent" value="${it.persistent}" />
      <h2>Persistent sandboxes</h2>
      <p>Long-lived sandboxes created with <code>sandboxRun(persistent: ...)</code>. Stopped ones keep their data and
        count toward the stored-sandbox quota of the account; delete the ones you no longer need.</p>
      <j:if test="${!empty(it.persistentMessage)}">
        <p id="persistent-message"><b>${it.persistentMessage}</b></p>
      </j:if>
      <j:forEach var="err" items="${persistent.errors}">
        <p class="persistent-error">${err}</p>
      </j:forEach>
      <j:choose>
        <j:when test="${empty(persistent.rows)}">
          <p id="no-persistent">No persistent sandboxes.</p>
        </j:when>
        <j:otherwise>
          <table class="jenkins-table sortable" id="persistent">
            <thead>
              <tr>
                <th>Name</th>
                <th>Account</th>
                <th>Status</th>
                <th>Created</th>
                <th>Sandbox id</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <j:forEach var="p" items="${persistent.rows}">
                <tr class="persistent-row" data-name="${p.name}">
                  <td>${p.name}</td>
                  <td>${p.accountId}</td>
                  <td class="persistent-status">${p.status}</td>
                  <td>${p.createdAt}</td>
                  <td><code>${p.sandboxId}</code></td>
                  <td>
                    <f:form method="post" action="stopPersistent?accountId=${p.accountId}&amp;name=${p.name}" name="stop-${p.accountId}-${p.name}">
                      <f:submit value="Stop" />
                    </f:form>
                    <f:form method="post" action="deletePersistent?accountId=${p.accountId}&amp;name=${p.name}" name="delete-${p.accountId}-${p.name}">
                      <f:submit value="Delete" />
                    </f:form>
                  </td>
                </tr>
              </j:forEach>
            </tbody>
          </table>
        </j:otherwise>
      </j:choose>
    </l:main-panel>
  </l:layout>
</j:jelly>
